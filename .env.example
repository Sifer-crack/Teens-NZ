# МолодЁЖ — environment placeholders
# Note: this is a static (serverless) site — nothing reads these yet at runtime.
# They document configurable values used across the pages so they can be wired
# to any future host, API, or build pipeline. Copy to .env and fill in real values.

# Telegram bot/community invite link shown in headers, footers, and join CTA.
TELEGRAM_BOT_URL=https://t.me/TeensNZ_bot

# Public contact email displayed on the contacts page.
CONTACT_EMAIL=hello@molodezh.community

# Community/region context (used in meta description / copy).
COMMUNITY_NAME=МолодЁЖ
